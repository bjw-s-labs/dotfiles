[commit]
	gpgsign = true
[core]
	autocrlf = input
	excludesfile = {{ .chezmoi.homeDir }}/.config/git/ignore
[gpg]
  format = ssh
[gpg "ssh"]
{{- if eq .chezmoi.os "darwin" }}
  program = "/Applications/1Password.app/Contents/MacOS/op-ssh-sign"
{{- end }}
	allowedSignersFile = "{{.chezmoi.homeDir}}/.ssh/allowed_signers"
[init]
	defaultBranch = main
[merge]
  ff = only
[pull]
	rebase = true
[push]
  autoSetupRemote = true
[rebase]
	autoStash = true
[status]
  submoduleSummary = false
[tag]
	forceSignAnnotated = true
	gpgSign = true
[url "ssh://git@github.com/"]
  pushInsteadOf = https://github.com/
[user]
	name = {{ .personal.full_name }}
	email = {{ .personal.git_email }}
	signingkey = {{ onepasswordRead "op://laoeuawucd7pzb4he4xin63e5u/rheuyl2qf53jedbi4tbhktzxcm/public key" }}
