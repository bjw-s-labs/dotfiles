[settings]
experimental = true
disable_hints = ["*"]

always_keep_download = false # deleted after install by default
always_keep_install = false  # deleted on failure by default

idiomatic_version_file_enable_tools = ["node"]

[env]
_.file = [
{{- if not .is_workstation }}
  { path="~/.config/mise/op.env.toml", redact=true}
{{- end }}
  { path="~/.config/mise/secrets.env.toml", redact=true},
]

[tools]
go = "latest"
node = "latest"
rust = "latest"
uv = "latest"

"github:jdx/fnox" = "latest"
"github:re-verse/rcp" = "latest"
"go:github.com/brumhard/krewfile" = "latest"
