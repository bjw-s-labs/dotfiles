{
  "$schema": "https://unpkg.com/oh-my-opencode-slim@latest/oh-my-opencode-slim.schema.json",
  "multiplexer": {
    "type": "auto",
    "layout": "main-vertical",
    "main_pane_size": 60
  },
  "preset": "opencode-go",
  "disabled_agents": [],
  "presets": {
    "opencode-go": {
      "orchestrator": {
        "model": "litellm/opencode-go/glm-5.2"
      },
      "oracle": {
        "model": "litellm/opencode-go/qwen3.7-max",
        "variant": "max"
      },
      "librarian": {
        "model": "litellm/opencode-go/deepseek-v4-flash"
      },
      "explorer": {
        "model": "litellm/opencode-go/deepseek-v4-flash"
      },
      "designer": {
        "model": "litellm/opencode-go/kimi-k2.7-code",
        "variant": "medium"
      },
      "fixer": {
        "model": "litellm/opencode-go/deepseek-v4-flash",
        "variant": "high"
      },
      "observer": {
        "model": "litellm/opencode-go/kimi-k2.6"
      }
    }
  },
  "council": {
    "presets": {
      "default": {
        "glm": {
          "model": "litellm/opencode-go/glm-5.2"
        },
        "kimi": {
          "model": "litellm/opencode-go/kimi-k2.6"
        },
        "qwen": {
          "model": "litellm/opencode-go/qwen3.7-max"
        },
        "minimax": {
          "model": "litellm/opencode-go/minimax-m3"
        }
      }
    },
    "default_preset": "default"
  },
  "agents": {
    "fixer-bigctx": {
      "model": "litellm/minimax/MiniMax-M3",
      "prompt": "You are fixer-bigctx, a scoped implementation specialist for work that exceeds 131k context or needs the strongest general multimodal model. You run on MiniMax M3 (1M context, vision). You are a weaker coder than the primary fixer (Qwen) but have a larger context window and a different model family. Use for: large-file edits, vision-driven implementation, and overflow when fixer lanes are saturated.",
      "orchestratorPrompt": "@fixer-bigctx\n- Role: Big-context / vision implementation overflow specialist (MiniMax M3, 1M, vision)\n- **Delegate when:** context exceeds 131k • vision-driven implementation tasks • when fixer lanes are saturated and more parallel coding capacity is needed\n- **Don't delegate when:** standard-sized scoped edits (prefer fixer) • pure reasoning/architecture (prefer oracle) • read-only recon (prefer explorer)"
    },
    "reviewer": {
      "model": "litellm/minimax/MiniMax-M3",
      "prompt": "You are reviewer, an independent code review and creative specialist. You run on MiniMax M3 (1M, vision), a different model family from GLM/Qwen. Use for: independent second opinions, code review, creative writing, and documentation prose.",
      "orchestratorPrompt": "@reviewer\n- Role: Independent review and creative specialist (MiniMax M3, different family from GLM/Qwen)\n- **Delegate when:** code review needs a second opinion • creative/prose tasks • high-stakes review (pair with fixer or oracle for cross-family consensus)\n- **Don't delegate when:** implementation (prefer fixer) • architecture decisions (prefer oracle) • recon (prefer explorer)"
    }
  }
}
